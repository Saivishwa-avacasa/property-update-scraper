# Copy to .env and fill in. Never commit .env.
# If this file is missing, the scraper falls back to ..\Scraper-for-RERA\.env,
# so you can leave it out when both projects sit side by side on E:\.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# Optional: CA for sslmode=verify-full. Defaults to certs/root.crt in this folder.
# PGSSLROOTCERT=certs/root.crt
